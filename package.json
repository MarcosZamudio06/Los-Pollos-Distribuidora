{
  "name": "pollos-distribuidor",
  "version": "1.0.0",
  "description": "TypeScript monorepo foundation for the chicken distributor system.",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:lint": "pnpm --dir frontend run lint",
    "frontend:preview": "pnpm --dir frontend run preview",
    "backend:build": "pnpm --dir backend run build",
    "backend:format": "pnpm --dir backend run format",
    "backend:start": "pnpm --dir backend run start",
    "backend:start:dev": "pnpm --dir backend run start:dev",
    "backend:lint": "pnpm --dir backend run lint",
    "backend:test": "pnpm --dir backend test",
    "backend:test:e2e": "pnpm --dir backend run test:e2e",
    "audit:dependencies": "audit-ci --package-manager pnpm --directory . --config audit-ci.jsonc && audit-ci --package-manager pnpm --directory backend --config audit-ci.jsonc && audit-ci --package-manager pnpm --directory frontend --config audit-ci.jsonc",
    "test:guard": "node scripts/forbid-exclusive-tests.mjs",
    "test": "pnpm --dir backend test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "headroom-ai": "^0.22.4",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "audit-ci": "7.1.0",
    "shadcn": "^4.13.0"
  }
}
