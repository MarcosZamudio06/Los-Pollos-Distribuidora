{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "browser:prepare": "ts-node test/browser-database.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --entryFile backend/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:docker": "npm run start:prod",
    "migrate:deploy": "prisma migrate deploy",
    "start:prod": "node dist/backend/src/main",
    "bootstrap:production": "ts-node prisma/bootstrap-production.ts",
    "bootstrap:production:rotate-admin": "ts-node prisma/bootstrap-production.ts --rotate-admin-password",
    "inventory:preflight": "ts-node prisma/scripts/cedis-inventory-preflight.ts",
    "evidence:migrate-to-object-storage": "ts-node prisma/scripts/migrate-delivery-evidence-to-object-storage.ts",
    "seed:development": "prisma db seed",
    "seed:operational": "ts-node prisma/seed.operational.ts",
    "lint": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,scripts}/**/*.ts\" --max-warnings 0 --rule 'prettier/prettier: off'",
    "typecheck": "tsc --project tsconfig.build.json --noEmit --incremental false",
    "pretest": "ts-node scripts/forbid-focused-tests.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "pretest:cov": "ts-node scripts/forbid-focused-tests.ts",
    "test:cov": "jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:e2e": "ts-node scripts/forbid-focused-tests.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 75,
        "lines": 80,
        "statements": 80
      }
    },
    "testTimeout": 15000,
    "testEnvironment": "node"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "js-yaml": "5.2.2",
    "uuid": "11.1.1"
  }
}
