# Server-only commercial receiver configuration. Never copy credentials into VITE_*.
LEAD_MODE=production
LEAD_PORT=4010
# Dedicated private directory, local durable filesystem; never a tenant DB or network share.
LEAD_DB_PATH=/var/lib/erp-commercial/leads.sqlite
LEAD_ORIGINS=
LEAD_PRIVACY_URL=
LEAD_PRIVACY_VERSION=
# Set true ONLY after owner/legal approval of the actual published notice.
LEAD_PRIVACY_APPROVED=false
LEAD_PROVIDER=resend
LEAD_MAIL_TO=
LEAD_MAIL_FROM=
LEAD_RESEND_API_KEY=
# Generate at least 32 random characters; maintain across restarts.
LEAD_RATE_SECRET=
# Optional trusted reverse proxy addresses, comma-separated IPs only; empty trusts no proxy.
# Configure only after the edge overwrites X-Forwarded-For and direct access is firewalled.
LEAD_TRUST_PROXY_IPS=
