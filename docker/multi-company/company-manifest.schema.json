{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["companies"],
  "properties": {
    "companies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/company"
      }
    }
  },
  "$defs": {
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "backupBucket",
        "displayName",
        "erpHost",
        "objectStorageHost",
        "environment",
        "deploymentHostRef",
        "status"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"
        },
        "backupBucket": {
          "type": "string",
          "minLength": 3,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])(?![\\s\\S])"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+(?![\\s\\S])"
        },
        "erpHost": {
          "$ref": "#/$defs/hostname"
        },
        "objectStorageHost": {
          "$ref": "#/$defs/hostname"
        },
        "environment": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "deploymentHostRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "provisioning",
            "active",
            "suspended",
            "decommissioned"
          ]
        },
        "secretRefs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "database": { "$ref": "#/$defs/secretReference" },
            "jwtAccess": { "$ref": "#/$defs/secretReference" },
            "jwtRefresh": { "$ref": "#/$defs/secretReference" },
            "objectStorage": { "$ref": "#/$defs/secretReference" },
            "backup": { "$ref": "#/$defs/secretReference" },
            "pac": { "$ref": "#/$defs/secretReference" },
            "csd": { "$ref": "#/$defs/secretReference" },
            "tls": { "$ref": "#/$defs/secretReference" },
            "bootstrapAdmin": { "$ref": "#/$defs/secretReference" }
          }
        }
      }
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}(?![\\s\\S])"
    },
    "secretReference": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?:vault|docker-secret|aws-sm|gcp-sm|azure-kv|op)://[A-Za-z0-9][A-Za-z0-9._/-]{0,478}(?![\\s\\S])"
    }
  }
}
