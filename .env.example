# Development Compose template. Production uses .env.production.example.
NODE_ENV=development
# Development only; production bootstrap receives this secret interactively.
SEED_ADMIN_PASSWORD=

# CFDI provider configuration. Fiscal issuance remains disabled until a later
# rollout. Use an opaque Docker-secret/secret-manager reference only; never put
# a Facturama password, token, CSD certificate, or private key in this file.
CFDI_ENABLED=false
CFDI_FISCAL_TIME_ZONE=America/Mexico_City
FISCAL_PROVIDER=FACTURAMA
FISCAL_PROVIDER_ENVIRONMENT=SANDBOX
CFDI_REQUEST_TIMEOUT_MS=30000
CFDI_MAX_RETRIES=3
FACTURAMA_API_BASE_URL=https://apisandbox.facturama.mx
FACTURAMA_API_MODE=MULTI_ISSUER
FACTURAMA_CREDENTIAL_REF=


FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5433

# Development images are built locally by docker-compose.yml. Production
# images are immutable GHCR references in .env.production.example.
BACKEND_IMAGE=pollos-distribuidor/backend:local
FRONTEND_IMAGE=pollos-distribuidor/frontend:local

# Production Docker json-file rotation for long-lived services.
# Compose applies these per service; the host daemon policy is documented separately.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

# Initial production resource guardrails for the 24 GiB / 8 vCPU single-host.
# These are Compose limits, not final workload sizing; keep host headroom.
POSTGRES_MEM_LIMIT=3.5g
POSTGRES_CPUS=1.25
BACKEND_MEM_LIMIT=2g
BACKEND_CPUS=1.25
BACKEND_NODE_MAX_OLD_SPACE_MB=1536
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=0.5
OBJECT_STORAGE_MEM_LIMIT=768m
OBJECT_STORAGE_CPUS=0.5
PHOTON_MEM_LIMIT=6g
PHOTON_CPUS=1.5
PHOTON_JAVA_XMS=1g
PHOTON_JAVA_XMX=4g
OSRM_MEM_LIMIT=5g
OSRM_CPUS=1.5
VROOM_MEM_LIMIT=1g
VROOM_CPUS=0.5
TILESERVER_MEM_LIMIT=1.5g
TILESERVER_CPUS=0.5

# Heavy GIS preparation jobs run one at a time under a shared lock.
MAP_PREPROCESS_MEMORY_LIMIT=4g
MAP_PREPROCESS_CPUS=2
PHOTON_PREP_IMAGE=alpine:3.21@sha256:48b0309ca019d89d40f670aa1bc06e426dc0931948452e8491e3d65087abc07d
PLANETILER_IMAGE=ghcr.io/onthegomap/planetiler:0.10.2@sha256:cf32202dbc001a9ab4bc11534b642b13de3798179817da8558e567a3d13dd403
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1@sha256:855614a38f464b0558a2ad6eaa7cb8c139f39887da9b38b485ce453c6e6e6124

# Development keeps the ignored checkout-local dataset. Production must
# override both values with an existing absolute directory outside the repo.
MAP_ENVIRONMENT=development
MAP_DATA_DIR=./.map-data
MAP_MIN_FREE_GB=8
MAP_RESERVED_HOST_GB=4
MAP_RESERVED_POSTGRES_GB=4
MAP_RESERVED_PERCENT=10
MAP_STAGING_SAFETY_FACTOR=1.25
MAP_MAX_HISTORY_VERSIONS=2
# Optional aggregate override for refresh preflight; otherwise HTTP
# Content-Length is required before a production refresh can allocate staging.
MAP_REFRESH_SOURCE_SIZE_BYTES=0
MAP_REFRESH_BACKEND_MONITOR_INTERVAL_SECONDS=2
MAP_REFRESH_BACKEND_HEALTH_URL=http://127.0.0.1:3000/api/health/ready
# Keep failed transaction candidates only while diagnosing a refresh failure.
MAP_REFRESH_KEEP_FAILED=0

# Each GIS provider has independent reproducible provenance. Production
# promotion requires a 64-character SHA-256 for every source and font input.
PHOTON_DATASET_VERSION=photon-mexico-1.0
PHOTON_DATA_SHA256=
PHOTON_SOURCE_SIZE_BYTES=0
PHOTON_CANDIDATE_SIZE_BYTES=0
OSRM_DATASET_VERSION=mexico-260812
OSRM_PBF_SHA256=
OSRM_SOURCE_SIZE_BYTES=0
OSRM_CANDIDATE_SIZE_BYTES=0
RENDERING_PBF_URL=https://download.geofabrik.de/north-america/mexico-260812.osm.pbf
RENDERING_DATASET_VERSION=mexico-260812
RENDERING_PBF_SHA256=
RENDERING_SOURCE_SIZE_BYTES=0
RENDERING_CANDIDATE_SIZE_BYTES=0
FONT_DATASET_VERSION=openmaptiles-fonts-v2.0
OPENMAPTILES_FONT_SHA256=
FONT_SOURCE_SIZE_BYTES=0
FONT_CANDIDATE_SIZE_BYTES=0

PORT=4000
API_PREFIX=api
SWAGGER_PATH=docs
SWAGGER_ENABLED=false
CORS_ORIGIN=http://localhost:3000
HTTP_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=0
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_FLEET_POSITION_MAX=60
FLEET_POSITION_STALE_SECONDS=60
FLEET_POSITION_FUTURE_TOLERANCE_SECONDS=300
FLEET_ANALYTICS_MAX_RANGE_DAYS=31
FLEET_POSITION_RETENTION_DAYS=365

DATABASE_SSL=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pollo_distribucion
# Development Compose keeps these providers on the private app_network.
PHOTON_URL=http://photon:2322
VROOM_URL=http://vroom:3000
OSRM_URL=http://osrm:5000
ROUTING_TIMEOUT_MS=10000
# Health dependency probes are intentionally short and bounded; GIS failures
# are reported as degraded without changing core ERP readiness semantics.
HEALTH_DEPENDENCY_TIMEOUT_MS=5000
# Application release label only; provider manifests above are authoritative
# for OSRM, rendering, and Photon and must not be inferred from this value.
MAP_DATA_VERSION=mexico-260812
MAP_DATA_PREPARED_AT=
MAP_DOCKER_PLATFORM=linux/amd64
MAP_TILES_URL=http://tileserver:8080
# Keep POSTGRES_* above DATABASE_URL. Compose production constructs its own
# internal URL with postgres:5432 and does not accept an external database URL.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Obligatorios. Genera valores aleatorios independientes de al menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_SESSION_IDLE_TTL_SECONDS=86400
AUTH_SESSION_LAST_USED_AT_UPDATE_THRESHOLD_SECONDS=300
BCRYPT_SALT_ROUNDS=10

# S3-compatible Object Storage for delivery evidence. Required in production.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
# Private Docker endpoint used by NestJS/S3 operations.
OBJECT_STORAGE_ENDPOINT=http://object-storage:8333
# Complete browser-facing URL used to generate signed download URLs.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:8333
# Browser-facing origin only (scheme + host + optional port) allowed by frontend CSP.
OBJECT_STORAGE_PUBLIC_ORIGIN=http://127.0.0.1:8333
# Production uses .env.production.example and sets both public values to
# https://objects.example.com.
# Caddy proxies that hostname to the loopback SeaweedFS binding only.
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# PostgreSQL/PostGIS backups to external Backblaze B2 through its S3 API.
# Keep these credentials separate from OBJECT_STORAGE_* and inject them only
# at runtime (for example through a root-readable systemd EnvironmentFile).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Retain the newest copy from each of these windows. The newest valid copy is
# always retained even when a window is configured as zero.
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=8
BACKUP_RETENTION_MONTHLY=6
# Leave enough free space for the dump and its end-to-end upload verification.
BACKUP_MIN_FREE_BYTES=1073741824
# Operational targets; the timer cadence must be compatible with these values.
BACKUP_RPO_HOURS=24
BACKUP_RTO_MINUTES=60

# Lightweight host monitoring. The systemd timer invokes the versioned monitor
# every five minutes; production values may be supplied from a root-only env file.
MONITOR_DISK_PATH=/
MONITOR_MAP_DATA_DIR=./.map-data
MONITOR_BACKUP_RESULT_DIR=./.backup-results
MONITOR_RESTORE_RESULT_DIR=./.restore-drills
MONITOR_STATE_FILE=./.monitor-state.json
MONITOR_DISK_WARN_PERCENT=80
MONITOR_DISK_CRITICAL_PERCENT=90
MONITOR_INODE_WARN_PERCENT=80
MONITOR_INODE_CRITICAL_PERCENT=90
MONITOR_MEMORY_WARN_PERCENT=85
MONITOR_MEMORY_CRITICAL_PERCENT=95
MONITOR_CPU_WARN_PERCENT=85
MONITOR_CPU_WARN_DURATION_SECONDS=900
MONITOR_RESTART_WARN_COUNT=3
MONITOR_BACKUP_MAX_AGE_HOURS=24
MONITOR_RESTORE_DRILL_MAX_AGE_DAYS=35
MONITOR_GIS_MAX_AGE_DAYS=31
MONITOR_HTTP_TIMEOUT_SECONDS=5
MONITOR_ALERT_WEBHOOK_URL=
MONITOR_ALERT_WEBHOOK_TIMEOUT_SECONDS=3

VITE_API_URL=/api
# Public MapLibre Style JSON URL. Required for production builds; never put secrets here.
VITE_MAP_STYLE_URL=/maps/styles/operations/style.json
