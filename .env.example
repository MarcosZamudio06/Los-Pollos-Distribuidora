NODE_ENV=production
# Required for the one-shot production bootstrap job. Never commit a real value.
SEED_ADMIN_PASSWORD=


FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5433

PORT=4000
API_PREFIX=api
SWAGGER_PATH=docs
SWAGGER_ENABLED=false
CORS_ORIGIN=http://localhost:3000
HTTP_BODY_LIMIT=1mb
TRUST_PROXY_HOPS=0
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_REFRESH_MAX=120
RATE_LIMIT_FLEET_POSITION_MAX=60
FLEET_POSITION_STALE_SECONDS=60
FLEET_POSITION_FUTURE_TOLERANCE_SECONDS=300
FLEET_ANALYTICS_MAX_RANGE_DAYS=31

DATABASE_SSL=false
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pollo_distribucion
# Required in production. Leave blank locally so development Compose uses its internal provider defaults.
PHOTON_URL=
VROOM_URL=
OSRM_URL=
ROUTING_TIMEOUT_MS=10000
MAP_DATA_VERSION=mexico-latest
MAP_DATA_PREPARED_AT=
MAP_DATA_DIR=./.map-data
MAP_DOCKER_PLATFORM=linux/amd64
# Keep POSTGRES_* above DATABASE_URL so Docker Compose can interpolate them when this file is copied to .env.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Obligatorios. Genera valores aleatorios independientes de al menos 32 caracteres.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SESSION_ABSOLUTE_TTL_SECONDS=604800
AUTH_SESSION_IDLE_TTL_SECONDS=86400
AUTH_SESSION_LAST_USED_AT_UPDATE_THRESHOLD_SECONDS=300
BCRYPT_SALT_ROUNDS=10

VITE_API_URL=/api
# Public MapLibre Style JSON URL. Required for production builds; never put secrets here.
VITE_MAP_STYLE_URL=
