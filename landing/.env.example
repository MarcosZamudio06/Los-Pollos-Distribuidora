# Public landing configuration. Keep the ERP on its own origin in production.
VITE_ERP_APP_URL=

# Optional approved product screenshots from landing/public.
# Example paths: /images/landing/dashboard.webp and /images/landing/inventory.webp
VITE_LANDING_DASHBOARD_IMAGE=
VITE_LANDING_POS_IMAGE=
VITE_LANDING_POS_MOBILE_IMAGE=
VITE_LANDING_INVENTORY_IMAGE=
VITE_LANDING_CEDIS_IMAGE=
VITE_LANDING_FLEET_IMAGE=
VITE_LANDING_ROUTE_PLANNER_IMAGE=
VITE_LANDING_DRIVER_IMAGE=
VITE_LANDING_BILLING_IMAGE=
VITE_LANDING_DEMO_REQUEST_URL=

# Optional accessible product demonstration; the section appears only when all four assets are set.
VITE_LANDING_DEMO_VIDEO_URL=
VITE_LANDING_DEMO_VIDEO_POSTER=
VITE_LANDING_DEMO_VIDEO_CAPTIONS=
VITE_LANDING_DEMO_VIDEO_TRANSCRIPT=

# Public commercial configuration. HTTPS public URLs only; NEVER put secrets here.
# Receiver must durably accept POST JSON and respond 2xx with {"accepted":true}.
VITE_LANDING_LEAD_ENDPOINT=
VITE_LANDING_PRIVACY_URL=
VITE_LANDING_TERMS_URL=
VITE_LANDING_CANONICAL_URL=
VITE_LANDING_SOCIAL_IMAGE=
VITE_LANDING_PURCHASES_IMAGE=
VITE_LANDING_COLLECTIONS_IMAGE=
# Optional local tooling override for protected dependency caches.
# LANDING_VITE_CACHE_DIR=/tmp/landing-vite-cache

# Verified commercial mailbox; absent/invalid channels use product exploration.
VITE_LANDING_CONTACT_EMAIL=
# Optional approved POS detail asset; bundled WebP is an authentic crop, not a demo sale.
VITE_LANDING_POS_DETAIL_IMAGE=

# Optional approved whole-frame daily-close screenshot.
VITE_LANDING_CLOSING_IMAGE=

# Optional approved mobile transport-arrival evidence; independent from commercial delivery.
VITE_LANDING_DRIVER_STOP_IMAGE=

# Must match the server's approved privacy version. Public identifier, never a secret.
VITE_LANDING_PRIVACY_VERSION=
# Local synthetic flow only: set via shell when running Vite in development mode.
# VITE_LANDING_LOCAL_LEADS=true
# VITE_LANDING_LEAD_ENDPOINT=/__lead-local/leads
# VITE_LANDING_PRIVACY_URL=/__lead-local/privacy
